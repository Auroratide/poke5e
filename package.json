{
	"name": "poke5e",
	"version": "1.12.16",
	"scripts": {
		"prepare": "husky && svelte-kit sync || echo ''",
		"start": "vite preview",
		"dev": "vite dev",
		"build": "vite build",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"clean": "rm -rf build",
		"ci": "npm-run-all clean check build",
		"gh": "gh-pages -d build --dotfiles",
		"publish": "npm-run-all ci gh",
		"script:get-pokemon-images": "node ./scripts/get-pokemon-images.js",
		"script:create-pokemon": "node ./scripts/create-pokemon.js",
		"test": "vitest run",
		"test:unit": "vitest run src",
		"test:functions": "deno run -A supabase/functions/test.ts",
		"test:smoke": "playwright test --project=smoke",
		"test:srd": "playwright test --project=srd",
		"test:smoke:debug": "playwright test --project=smoke --headed",
		"test:smoke:report": "playwright show-report",
		"test:db": "supabase db reset && vitest run test/db/*.test.ts",
		"test:db:quick": "vitest run test/db/*.test.ts",
		"lint": "eslint src",
		"services:start": "supabase start && docker compose up -d",
		"services:stop": "supabase stop && docker compose down",
		"machine-translate": "inlang machine translate --project project.inlang",
		"localization:canonical": "node scripts/localization/generate-canonical-names.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@inlang/cli": "^3.4.4",
		"@inlang/paraglide-js": "^2.29.1",
		"@playwright/test": "1.64.1",
		"@readme/openapi-parser": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"@vitest/browser": "^4.1.12",
		"@vitest/browser-playwright": "^4.1.12",
		"ajv": "^8.20.0",
		"chalk": "^5.6.2",
		"cheerio": "^1.2.0",
		"chromium-bidi": "^13.1.1",
		"csv-parse": "^6.2.1",
		"dotenv": "^16.6.1",
		"eslint": "^9.39.5",
		"eslint-plugin-only-error": "^1.0.2",
		"eslint-plugin-svelte": "^3.23.1",
		"gh-pages": "^3.2.3",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"mdsvex": "^0.12.8",
		"npm-run-all": "^4.1.5",
		"openapi-types": "^12.1.3",
		"pg": "^8.23.1",
		"playwright": "^1.64.1",
		"postgres-migrations": "^5.3.0",
		"supabase": "^2.122.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-preprocess": "^6.0.5",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^4.1.12"
	},
	"type": "module",
	"license": "ISC",
	"author": {
		"name": "Timothy Foster",
		"url": "https://auroratide.com"
	},
	"dependencies": {
		"@auroratide/img-zoom": "^0.1.9",
		"@auroratide/pokemon-types": "^0.1.0",
		"@auroratide/reorder-list": "^0.6.1",
		"@auroratide/tab-list": "^0.2.6",
		"@auroratide/textarea-markdown": "^0.1.2",
		"@auroratide/toggle-switch": "^0.3.1",
		"@floating-ui/dom": "^1.8.0",
		"@supabase/supabase-js": "^2.118.0",
		"dompurify": "^3.4.17",
		"marked": "^15.0.12",
		"zod": "^4.6.7"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"pnpm": "^10.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"puppeteer",
			"supabase",
			"svelte-preprocess",
			"taiko"
		]
	}
}
